{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "strict": true,
    "declaration": true, "sourceMap": false, "skipLibCheck": true, "types": ["node"],
    "forceConsistentCasingInFileNames": true, "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
