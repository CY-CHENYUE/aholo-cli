  "specVersion": "2.0",
  "operations": {
    "createMultimodalToImageTask": {
      "path": "/lux3d/v1/generate/multimodal-to-image/task/create",
      "method": "POST",
      "schema": {
        "type": "object",
        "properties": {
          "img": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "prompt": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "createImageToFourViewTask": {
      "path": "/lux3d/v1/generate/image-to-four-view/task/create",
      "method": "POST",
      "schema": {
        "type": "object",
        "properties": {
          "img": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "prompt": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "createImgTo3dTask": {
      "path": "/lux3d/v1/generate/img-to-3d/task/create",
      "method": "POST",
      "schema": {
        "type": "object",
        "properties": {
          "img": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "imgs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            }
          },
          "version": {
            "type": "string",
            "enum": [
              "G1",
              "G1-Turbo"
            ]
          },
          "faceCount": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 300000
          },
          "outputFormat": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "zip",
                "glb",
                "ply"
              ]
            }
          },
          "enablePbr": {
            "type": "boolean"
          },
          "aiPredictSize": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "createTextTo3dTask": {
      "path": "/lux3d/v1/generate/text-to-3d/task/create",
      "method": "POST",
      "schema": {
        "required": [
          "prompt"
        ],
        "type": "object",
        "properties": {
          "prompt": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "style": {
            "type": "string",
            "enum": [
              "photorealistic",
              "cartoon",
              "anime",
              "hand_painted",
              "cyberpunk",
              "fantasy",
              "glass"
            ]
          },
          "img": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "enum": [
              "G1",
              "G1-Turbo"
            ]
          },
          "faceCount": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 300000
          },
          "outputFormat": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "zip",
                "glb",
                "ply"
              ]
            }
          },
          "enablePbr": {
            "type": "boolean"
          },
          "aiPredictSize": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "createMaterialTransferTask": {
      "path": "/lux3d/v1/generate/material-transfer/task/create",
      "method": "POST",
      "schema": {
        "required": [
          "img",
          "meshUrl",
          "version"
        ],
        "type": "object",
        "properties": {
          "img": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "meshUrl": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "version": {
            "type": "string",
            "enum": [
              "v3.0-standard"
            ]
          },
          "outputFormat": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "zip",
                "glb",
                "usdz",
                "obj_zip",
                "fbx_zip"
              ]
            }
          },
          "aiPredictSize": {
            "type": "boolean"
          },
          "customSize": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "createPartSplitTask": {
      "path": "/lux3d/v1/part-split/task/create",
      "method": "POST",
      "schema": {
        "required": [
          "glbUrl"
        ],
        "type": "object",
        "properties": {
          "glbUrl": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "createMultiFormatExportTask": {
      "path": "/lux3d/v1/multi-format-export/task/create",
      "method": "POST",
      "schema": {
        "required": [
          "modelUrl"
        ],
        "type": "object",
        "properties": {
          "modelUrl": {
            "minLength": 1,
            "type": "string"
          },
          "outputFormat": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "usdz",
                "obj_zip",
                "fbx_zip",
                "stl",
                "3mf"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "createArticulationAnimationTask": {
      "path": "/lux3d/v1/articulation-animation/task/create",
      "method": "POST",
      "schema": {
        "type": "object",
        "required": [
          "glbUrl",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "glbUrl": {
            "type": "string",
            "format": "uri",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "createHumanoidAutoRigTask": {
      "path": "/lux3d/v1/animations/rig/task/create",
