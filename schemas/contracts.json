    "getTask": {
      "path": "/lux3d/v1/generate/task/get",
      "method": "GET",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskid": {
            "type": "integer"
          }
        },
        "required": [
          "taskid"
        ]
      }
    },
    "listTasks": {
      "path": "/lux3d/v1/generate/task/list",
      "method": "GET",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
